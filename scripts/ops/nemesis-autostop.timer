# Fallback for the AWS-side schedule (EventBridge Scheduler nemesis-web-stop-2026-11-17, 18:00 UTC).
# Not Persistent: if the box is started again after this date, the elapsed timer does not fire at boot.
[Unit]
Description=One-off stop of the Nemesis box on 2026-11-17 18:05 UTC

[Timer]
OnCalendar=2026-11-17 18:05:00 UTC
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
